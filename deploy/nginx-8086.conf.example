server {
    listen 8086;
    listen [::]:8086;
    server_name 192.168.1.10 correspondence.lan;

    client_max_body_size 25M;

    access_log /var/log/nginx/correspondence.access.log;
    error_log  /var/log/nginx/correspondence.error.log;

    location /static/ {
        alias @BASE_DIR@/app/staticfiles/;
        access_log off;
        expires 7d;
    }

    # Replace with authenticated attachment downloads before production use.
    location /media/ {
        deny all;
    }

    location / {
        proxy_pass http://127.0.0.1:8087;
        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_redirect off;
        proxy_read_timeout 60s;
    }
}
