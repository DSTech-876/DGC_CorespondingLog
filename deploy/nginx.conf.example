server {
    listen 80;
    server_name correspondence.local;
    client_max_body_size 25M;

    location /static/ {
        alias /opt/correspondence-cms/staticfiles/;
    }

    # Do not expose private_media directly in production.
    # Implement an authenticated download view before enabling attachments.

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8001;
    }
}
