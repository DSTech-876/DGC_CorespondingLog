DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
DB_NAME=correspondence_db
DB_USER=correspondence_user
DB_PASSWORD=replace-this-password
DB_HOST=127.0.0.1
DB_PORT=5432
MEDIA_ROOT=/var/lib/correspondence-cms/media
# Optional: ports used for CSRF origins (default 8000,8001,8086)
#DJANGO_SITE_PORTS=8086
# Optional: initial admin created by `manage.py seed_admin`
#DJANGO_SUPERUSER_USERNAME=admin
#DJANGO_SUPERUSER_EMAIL=admin@example.com
#DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password
# Optional: outgoing mail for password-reset links. Without EMAIL_HOST the
# reset message is printed to the service log instead of being emailed.
#EMAIL_HOST=smtp.example.gov.jm
#EMAIL_PORT=587
#EMAIL_USE_TLS=1
#EMAIL_HOST_USER=correspondence@example.gov.jm
#EMAIL_HOST_PASSWORD=replace-this-password
#DEFAULT_FROM_EMAIL=Correspondence Register <no-reply@example.gov.jm>
# Optional: password-reset link lifetime in seconds (default 7200 = 2h)
#PASSWORD_RESET_TIMEOUT=7200
