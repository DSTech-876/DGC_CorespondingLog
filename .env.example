DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
DB_NAME=correspondence_db
DB_USER=correspondence_user
DB_PASSWORD=replace-this-password
DB_HOST=127.0.0.1
DB_PORT=5432
MEDIA_ROOT=/var/lib/correspondence-cms/media
# Optional: ports used for CSRF origins (default 8000,8001,8086)
#DJANGO_SITE_PORTS=8086
# Optional: initial admin created by `manage.py seed_admin`
#DJANGO_SUPERUSER_USERNAME=admin
#DJANGO_SUPERUSER_EMAIL=admin@example.com
#DJANGO_SUPERUSER_PASSWORD=choose-a-strong-password
